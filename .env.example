# LLM Provider Configuration
# Choose provider: "omniroute" or "openrouter" (default)
LLM_PROVIDER=omniroute

# Omniroute API Configuration
OMNIROUTE_API_KEY=your-omniroute-api-key
OMNIROUTE_BASE_URL=http://localhost:20128
OMNIROUTE_MODEL=default

# OpenRouter API (Alternative)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=mistralai/mistral-nemo

# Pexels API (required for M3 - B-roll video search)
# Free tier: https://www.pexels.com/api/
PEXELS_API_KEY=your-pexels-api-key-here

# Kokoro TTS (optional for M3 - text-to-speech)
# Local server endpoint (default: http://localhost:8880/v1)
# If not available, pipeline uses silent audio fallback
KOKORO_BASE_URL=http://localhost:8880/v1
